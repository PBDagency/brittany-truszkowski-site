---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Page not found | Brittany Truszkowski">
  <section class="top">
    <Header />
  </section>
  <main id="main" class="wrap missing">
    <h1>This page isn't here yet.</h1>
    <p>The page you're looking for is still being built, or the link has changed.</p>
    <a class="btn" href="/">Go to the homepage</a>
  </main>
  <Footer />
</Base>

<style>
  .top {
    position: relative;
    min-height: 120px;
    background: var(--midnight);
  }
  .missing {
    padding-block: clamp(96px, 14vw, 180px) calc(clamp(96px, 14vw, 180px) + 100px);
  }
  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--midnight);
    max-width: 16ch;
  }
  p { margin: 20px 0 36px; max-width: 44ch; }
</style>
