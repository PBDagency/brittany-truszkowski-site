---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Desert from '../components/Desert.astro';
import { SPEAK_HREF } from '../site';
import portrait from '../assets/brittany-portrait.jpg';
---

<Base>
  <section class="hero">
    <Header />
    <div class="sky-back"><Desert part="back" /></div>

    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>
          <span class="h1-line">Leadership with Purpose.</span>
          <span class="h1-script">Impact by Design.</span>
        </h1>
        <p class="lede">
          Transforming law firms, strengthening businesses, and developing leaders who make a lasting impact.
        </p>
        <div class="actions">
          <a class="btn" href={SPEAK_HREF}>Invite me to speak</a>
          <a class="text-link" href="/about">Explore my story</a>
        </div>
      </div>

      <figure class="portrait">
        <div class="arch">
          <Image
            src={portrait}
            alt="Brittany Truszkowski"
            widths={[360, 540, 720, 900]}
            sizes="(max-width: 960px) 78vw, 440px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </figure>
    </div>

    <div class="sky-front"><Desert part="front" /></div>
  </section>

  <main id="main">
    <section class="intro">
      <div class="wrap intro-grid">
        <h2 class="statement">
          <span>Legal industry expertise.</span>
          <span>Business-minded leadership.</span>
          <span>People-first impact.</span>
        </h2>
        <div class="intro-body">
          <p>
            Brittany builds the systems, culture, and teams that help organizations grow. Her roots are in law
            firm operations, and the lessons travel to any business that runs on people.
          </p>
          <a class="text-link link-copper" href="/about">Explore my story</a>
        </div>
      </div>
    </section>

    <section class="area area-legal" aria-labelledby="legal-title">
      <div class="wrap area-grid">
        <h2 id="legal-title">Legal leadership</h2>
        <div class="area-body">
          <p class="area-lead">Stronger law firms, built from the inside out.</p>
          <p>
            Operations, people, and the systems that hold them together. Through The Legal COO, Brittany shares
            what it takes to run a firm well, for managing partners, firm administrators, and the leaders coming
            up behind them.
          </p>
          <a class="text-link link-copper" href="/the-legal-coo">Explore The Legal COO</a>
        </div>
      </div>
    </section>

    <section class="area area-speaking" aria-labelledby="speaking-title">
      <div class="wrap area-grid">
        <h2 id="speaking-title">Speaking &amp; insights</h2>
        <div class="area-body">
          <p class="area-lead">Real-world strategy for leaders who have to make it work on Monday.</p>
          <p>
            Keynotes, panels, and workshops on leadership, law firm operations, and building teams people want to
            stay on.
          </p>
          <div class="actions">
            <a class="btn" href={SPEAK_HREF}>Invite me to speak</a>
            <a class="text-link" href="/insights">Read insights</a>
          </div>
        </div>
      </div>
    </section>

    <section class="area area-causes" aria-labelledby="causes-title">
      <div class="wrap area-grid">
        <h2 id="causes-title">Causes &amp; community</h2>
        <div class="area-body">
          <p class="area-lead">The same people-first leadership, pointed where it's needed most.</p>
          <p>Mentoring, nonprofit leadership, and community work that creates opportunity for others.</p>
          <a class="text-link link-sage" href="/causes">See the causes Brittany supports</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---------------- Hero ---------------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(700px, 100svh, 960px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--ivory);
    background:
      radial-gradient(ellipse 60% 45% at 74% 78%, rgba(217, 138, 108, 0.55), rgba(196, 106, 74, 0) 70%),
      linear-gradient(180deg, var(--midnight) 0%, #12303F 38%, #33313E 64%, #7B4A45 82%, #B8664A 100%);
  }

  .sky-back,
  .sky-front {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: clamp(170px, 24vw, 340px);
    pointer-events: none;
  }
  .sky-back { z-index: 0; }
  .sky-front { z-index: 2; }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: end;
    gap: 48px;
    padding-top: 140px;
  }

  .hero-copy {
    padding-bottom: clamp(140px, 16vw, 230px);
    position: relative;
    z-index: 3;
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: 0.06em;
  }
  .h1-line {
    font-size: clamp(2.75rem, 5.2vw, 4.75rem);
    font-weight: 500;
    line-height: 1.02;
  }
  .h1-script {
    font-family: var(--font-script);
    font-weight: 400;
    font-size: clamp(2.75rem, 6.2vw, 5.75rem);
    line-height: 1.05;
    color: var(--sandstone);
    letter-spacing: 0;
    white-space: nowrap;
    padding-left: 0.3em;
  }

  .lede {
    max-width: 34ch;
    margin-top: 28px;
    font-size: clamp(1.125rem, 1.6vw, 1.3125rem);
    line-height: 1.55;
    color: rgba(250, 247, 242, 0.88);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    margin-top: 40px;
  }
  .hero .text-link,
  .area-speaking .text-link { text-decoration-color: var(--copper-light); }
  .hero .text-link:hover,
  .area-speaking .text-link:hover { text-decoration-color: var(--ivory); }

  /* Portrait in an arch, with the setting sun behind it */
  .portrait {
    margin: 0;
    position: relative;
    justify-self: center;
    width: clamp(280px, 32vw, 440px);
  }
  .portrait::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: 50%;
    top: -14%;
    width: 165%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(240, 178, 132, 0.6) 0%,
      rgba(217, 138, 108, 0.38) 34%,
      rgba(196, 106, 74, 0) 68%
    );
  }
  .portrait::after {
    content: '';
    position: absolute;
    inset: -18px -18px 0 -18px;
    border: 1px solid rgba(232, 211, 193, 0.5);
    border-bottom: 0;
    border-radius: 999px 999px 0 0;
    pointer-events: none;
  }
  .arch {
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px 0 0;
    overflow: hidden;
    background: #33313E;
  }
  .arch :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }

  /* One orchestrated load moment: the sun warms, the words rise */
  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes glow {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .portrait::before { animation: glow 1600ms ease-out both; }
  .h1-line { animation: rise 900ms 150ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .h1-script { animation: rise 900ms 380ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .lede, .hero .actions { animation: rise 900ms 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }

  /* ---------------- Intro statement ---------------- */
  .intro { padding-block: var(--section-y) calc(var(--section-y) * 0.8); }
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    row-gap: clamp(40px, 5vw, 64px);
    column-gap: clamp(32px, 6vw, 96px);
  }
  .statement {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    font-size: clamp(2.1rem, 4.4vw, 3.9rem);
    line-height: 1.14;
    color: var(--midnight);
  }
  .statement span { white-space: nowrap; }
  .statement span:nth-child(2) { padding-left: 1.1em; }
  .statement span:nth-child(3) { padding-left: 2.2em; color: var(--copper-ink); }
  .intro-body { grid-column: 2; }
  .intro-body p { max-width: 38ch; margin-bottom: 24px; }

  .link-copper { color: var(--copper-ink); }
  .link-sage { color: var(--sage-ink); }
  .link-copper:hover, .link-sage:hover { color: var(--midnight); }

  /* ---------------- Three areas ---------------- */
  .area { padding-block: clamp(72px, 10vw, 136px); }
  .area-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .area h2 {
    font-size: clamp(2.25rem, 4.4vw, 3.5rem);
    padding-top: 28px;
    border-top: 2px solid currentColor;
    max-width: 12ch;
  }
  .area-body { padding-top: 32px; }
  .area-body > p { max-width: 46ch; }
  .area-body > p + p { margin-top: 16px; }
  .area-body > .text-link,
  .area-body > .actions { display: inline-flex; margin-top: 28px; }
  .area-lead {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    line-height: 1.3;
  }

  .area-legal { background: var(--sand-wash); }
  .area-legal h2 { color: var(--midnight); border-top-color: var(--copper); }
  .area-legal .area-lead { color: var(--midnight); }

  .area-speaking { background: var(--midnight); color: var(--ivory); }
  .area-speaking h2 { border-top-color: var(--copper); }
  .area-speaking .area-body > p:not(.area-lead) { color: rgba(250, 247, 242, 0.85); }
  .area-speaking .area-lead { color: var(--sandstone); }

  .area-causes {
    background: var(--ivory);
    padding-bottom: calc(clamp(72px, 10vw, 136px) + clamp(60px, 9vw, 120px));
  }
  .area-causes h2 { color: var(--midnight); border-top-color: var(--sage); }
  .area-causes .area-lead { color: var(--midnight); }

  /* ---------------- Responsive ---------------- */
  @media (max-width: 960px) {
    .hero { min-height: 0; }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 56px;
      padding-top: 128px;
    }
    .hero-copy { padding-bottom: 0; }
    .portrait { width: min(78vw, 360px); }
    .sky-back, .sky-front { height: clamp(150px, 34vw, 260px); }

    .area-grid { grid-template-columns: 1fr; }
    .area-body { padding-top: 0; }
  }

  @media (max-width: 720px) {
    .intro-grid { grid-template-columns: 1fr; }
    .intro-body { grid-column: 1; }
    .statement span { white-space: normal; }
    .statement span:nth-child(2),
    .statement span:nth-child(3) { padding-left: 0; }
    .statement span + span { margin-top: 0.15em; }
  }

  @media (max-width: 480px) {
    .h1-script { padding-left: 0.1em; }
    .actions .btn { width: 100%; }
  }
</style>
