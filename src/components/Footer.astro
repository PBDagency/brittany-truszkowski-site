---
import { NAV, SITE, SPEAK_HREF } from '../site';
import Desert from './Desert.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="ridge"><Desert part="front" /></div>
  <div class="wrap inner">
    <div class="closing">
      <p class="closing-line">Let's build something that lasts.</p>
      <a class="btn" href={SPEAK_HREF}>Invite me to speak</a>
    </div>

    <div class="meta">
      <nav aria-label="Footer">
        <ul>
          {NAV.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          {SITE.linkedin && <li><a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>}
        </ul>
      </nav>
      <p class="copy">© {year} {SITE.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--midnight-deep);
    color: var(--ivory);
    padding-bottom: 40px;
  }
  .ridge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: clamp(60px, 9vw, 120px);
    pointer-events: none;
  }
  .inner { padding-top: clamp(56px, 8vw, 96px); }

  .closing {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding-bottom: clamp(48px, 7vw, 80px);
    border-bottom: 1px solid rgba(232, 211, 193, 0.18);
  }
  .closing-line {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    line-height: 1.1;
    max-width: 16ch;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-top: 28px;
  }
  .meta ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .meta a {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--sandstone);
  }
  .meta a:hover { color: var(--ivory); text-decoration: underline; text-underline-offset: 5px; }
  .copy {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: rgba(232, 211, 193, 0.75);
  }
</style>
