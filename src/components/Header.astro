---
import { NAV, SPEAK_HREF } from '../site';
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label="Brittany Truszkowski, home">
      <span>Brittany</span>
      <span>Truszkowski</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn-small" href={SPEAK_HREF}>Invite me to speak</a>
    </nav>

    <details class="menu">
      <summary>
        <span class="menu-label">Menu</span>
        <span class="menu-icon" aria-hidden="true"></span>
      </summary>
      <div class="menu-panel">
        <ul>
          {NAV.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
        <a class="btn" href={SPEAK_HREF}>Invite me to speak</a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 20;
    color: var(--ivory);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding-block: 28px;
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .wordmark span:last-child { padding-left: 1.1em; }

  .nav {
    display: flex;
    align-items: center;
    gap: 36px;
  }
  .nav ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    padding-block: 6px;
    border-bottom: 1px solid transparent;
    transition: border-color 160ms ease;
  }
  .nav ul a:hover,
  .nav ul a[aria-current='page'] { border-bottom-color: var(--copper-light); }

  .btn-small {
    min-height: 44px;
    padding: 10px 22px;
    font-size: 0.875rem;
  }

  /* Mobile menu */
  .menu { display: none; position: relative; }
  .menu summary {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu-icon,
  .menu-icon::before {
    display: block;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    transition: transform 200ms ease;
  }
  .menu-icon { position: relative; }
  .menu-icon::before { content: ''; position: absolute; top: 6px; left: 0; }
  .menu[open] .menu-icon { transform: translateY(3px) rotate(45deg); }
  .menu[open] .menu-icon::before { transform: translateY(-6px) rotate(-90deg); }

  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    width: min(320px, calc(100vw - 32px));
    padding: 24px;
    background: var(--ivory);
    color: var(--midnight);
    border-radius: 4px;
    box-shadow: 0 24px 60px rgba(10, 31, 43, 0.35);
  }
  .menu-panel ul { list-style: none; margin: 0 0 20px; padding: 0; }
  .menu-panel li + li { border-top: 1px solid var(--sandstone); }
  .menu-panel ul a {
    display: block;
    padding: 14px 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    text-decoration: none;
  }
  .menu-panel .btn { width: 100%; }

  @media (max-width: 960px) {
    .nav { display: none; }
    .menu { display: block; }
  }
</style>
